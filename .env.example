# Copiază fișierul în .env și completează cu datele din
# Firebase Console → Project settings → Your apps → Web app.
# Dacă lași valorile goale, aplicația pornește în modul demo.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Gemini prin Firebase AI Logic cere App Check (obligatoriu din 2 noiembrie 2026).
# În Expo Go folosește un token de debug: App Check → Apps → aplicația Web → ⋮ → Manage debug tokens → Add.
# Generează un UUID (ex. pe uuidgenerator.net), adaugă-l în consolă și pune-l aici.
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=

# Opțional: alt model Gemini (lista actuală e în consola AI Logic).
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.5-flash-lite
